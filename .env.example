# Horekia — plantilla sin secretos. Copiar a .env para desarrollo.
# IA real: requiere la credencial Gemini del proyecto.
AI_MOCK=false

# Backend: conexión directa PostgreSQL; no se usa Supabase Auth.
SUPABASE_URL=
DATABASE_URL=

# Modelos Gemini del proyecto; no incluir credenciales en este archivo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Email transaccional de la POC. Verifica el dominio en Resend antes de enviar.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=HorekIA

# Frontend: URL pública de la API. Nunca poner claves secretas aquí.
EXPO_PUBLIC_API_URL=http://localhost:8000

# API access from the web applications. Comma-separated origins in production.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082,http://localhost:5173,http://127.0.0.1:5173,https://app.horekia.com,https://backoffice.horekia.com,https://horekia.com,https://www.horekia.com

# Backoffice master account. Set privately before running the bootstrap script.
BACKOFFICE_MASTER_EMAIL=
BACKOFFICE_MASTER_PASSWORD=

# Tenant shown by the public chat app.
EXPO_PUBLIC_TENANT_SLUG=empresa-demo-uno

# Imágenes de productos: directorio local en la POC y URL pública en producción.
PRODUCT_UPLOAD_DIR=./uploads/products
MEDIA_PUBLIC_BASE_URL=http://localhost:8000/media
