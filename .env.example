# Horekia — plantilla sin secretos. Copiar a .env para desarrollo.
# IA simulada: no requiere credenciales Gemini.
AI_MOCK=true

# Backend: conexión directa PostgreSQL; no se usa Supabase Auth.
SUPABASE_URL=
DATABASE_URL=

# IA real: completar únicamente cuando se vaya a activar.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=

# Frontend: URL pública de la API. Nunca poner claves secretas aquí.
EXPO_PUBLIC_API_URL=http://localhost:8000
