# Horekia — plantilla sin secretos. Copiar a .env para desarrollo.
# IA simulada: no requiere credenciales Gemini.
AI_MOCK=true

# Backend: completar al configurar Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# IA real: completar únicamente cuando se vaya a activar.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=

# Frontend: variables públicas. Nunca poner claves secretas aquí.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
