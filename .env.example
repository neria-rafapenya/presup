# Horekia — plantilla sin secretos. Copiar a .env para desarrollo.
# IA real: requiere la credencial Gemini del proyecto.
AI_MOCK=false

# Backend: conexión directa PostgreSQL; no se usa Supabase Auth.
SUPABASE_URL=
DATABASE_URL=

# Modelos Gemini del proyecto; no incluir credenciales en este archivo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Frontend: URL pública de la API. Nunca poner claves secretas aquí.
EXPO_PUBLIC_API_URL=http://localhost:8000
